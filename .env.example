# --- gateway ---
PORT=8080
NODE_ENV=production
# 32+ random chars, signs admin session cookies
SESSION_SECRET=change-me-to-a-long-random-string
# shared secret the WordPress plugin uses to sign server-to-server events (HMAC)
INGEST_SECRET=change-me-too
# host the admin dashboard answers on; every other host serves only the collector
ADMIN_HOST=gw.example.com

# --- database ---
DATABASE_URL=postgres://gateway:password@db:5432/gateway

# --- behaviour ---
# how many queued events a worker tick sends at once
BATCH_SIZE=25
# worker tick interval in ms
WORKER_INTERVAL_MS=2000
# how long to keep delivered events for the admin log (days)
RETENTION_DAYS=30
